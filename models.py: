from sqlalchemy import (
    Column,
    Integer,
    String,
    DateTime,
    Text
)

from database import Base


class Client(Base):

    __tablename__ = "clients"

    id = Column(
        Integer,
        primary_key=True,
        index=True
    )

    name = Column(
        String,
        nullable=False
    )

    phone = Column(
        String,
        nullable=False
    )

    product = Column(
        String,
        nullable=True
    )

    notes = Column(
        Text,
        nullable=True
    )


class FollowUp(Base):

    __tablename__ = "followups"

    id = Column(
        Integer,
        primary_key=True,
        index=True
    )

    client_id = Column(
        Integer,
        nullable=False
    )

    scheduled_at = Column(
        DateTime,
        nullable=False
    )

    status = Column(
        String,
        default="scheduled"
    )

    outcome = Column(
        Text,
        nullable=True
    )
